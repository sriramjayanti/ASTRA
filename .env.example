# ==============================================================================
# ASTRA Production Environment Configuration Template
# Copy to .env and customize as needed. Never commit secrets or local credentials.
# ==============================================================================

# Hardware Acceleration: "auto", "cpu", "cuda", "cuda:0", "directml"
ASTRA_DEVICE=auto

# Directory Overrides (defaults to workspace relative paths if unset)
ASTRA_MODEL_DIR=checkpoints
ASTRA_CONFIG_DIR=configs
ASTRA_OUTPUT_DIR=outputs
ASTRA_LOG_DIR=logs
ASTRA_CACHE_DIR=.cache

# Logging Configuration: DEBUG, INFO, WARNING, ERROR, CRITICAL
ASTRA_LOG_LEVEL=INFO
ASTRA_STRUCTURED_LOGS=false

# Runtime & Pipeline Limits
ASTRA_MAX_CANDIDATES=24
ASTRA_PIPELINE_TIMEOUT_SEC=120
ASTRA_MAX_SAMPLE_POINTS=500000

# GUI Settings
ASTRA_GUI_ENABLE_OPENGL=true
ASTRA_GUI_FPS_TARGET=60
ASTRA_PRODUCTION_MODE=true
